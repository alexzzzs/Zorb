export fn zast_append_warning(self: *ZAstModule, allocator: *std.mem.HeapAllocator, warning: ZAstWarning) !i64 {
    zast_reserve_warnings(self, allocator, self.warning_count + 1) catch |err| { return err }
    self.warnings[self.warning_count] = warning
    self.warning_count = self.warning_count + 1
    return 0
}


