import "mem.zorb"
import "errors.zorb"
import "os.zorb"
import c "windows.h"

extern fn ConvertThreadToFiber(lpParameter: *void) -> *void
extern fn CreateFiber(dwStackSize: i64, lpStartAddress: fn(*void) -> void, lpParameter: *void) -> *void
extern fn SwitchToFiber(lpFiber: *void) -> void
extern fn DeleteFiber(lpFiber: *void) -> void

export struct Fiber {
    id: i64,
    stack_ptr: *u8,
    owned_stack_ptr: *u8,
    owned_stack_len: i64,
    owned_record_ptr: *u8,
    owned_record_len: i64,
    state: i32, // 0: Ready, 1: Waiting, 2: Dead
    func: fn(*void) -> void,
    arg: *void,
    next: *Fiber
    wait_fd: i32,
    wait_events: i16,
    wait_revents: i16,
    wait_deadline_ms: i64,
    wait_timed_out: bool,
    waiting_next: *Fiber
}

export current_fiber: *Fiber = cast(*Fiber, 0)
export ready_queue_head: *Fiber = cast(*Fiber, 0)
export ready_queue_tail: *Fiber = cast(*Fiber, 0)
export scheduler_sp: *u8 = cast(*u8, 0)

// Stage AArch64 switch operands outside the raw switch routine. At -O0 the
// native compiler spills ordinary function parameters into a stack frame.
// A stack switch cannot safely return through a prologue-owned frame when the
// destination is a newly constructed fiber stack.
aarch64_old_sp_ptr: **u8 = cast(**u8, 0)
aarch64_new_sp: *u8 = cast(*u8, 0)

// The fix: track active fibers
export active_fibers: i64 = 0

task_next_id: i64 = 1

export fn std.task.is_supported() -> bool {
    if Builtin.IsBareMetal {
        return false
    }

    if !Builtin.IsLinux && !Builtin.IsWindows {
        return false
    }

    if Builtin.IsX86_64 {
        return true
    }

    if Builtin.IsAArch64 {
        return true
    }

    return false
}

fn std.task.context_switch_barrier() {
    if Builtin.IsX86_64 {
        asm {
            ""
            : : : "rax", "rcx", "rdx", "rsi", "rdi", "r8", "r9", "r10", "r11", "memory"
        }
    }

    if Builtin.IsAArch64 {
        asm {
            ""
            : : : "x0", "x1", "x2", "x3", "x4", "x5", "x6", "x7", "x8", "x9", "x10", "x11", "x12", "x13", "x14", "x15", "x16", "x17", "x18", "memory"
        }
    }
}

fn fiber_entry_point() {
    f: *Fiber = current_fiber
    f.func(f.arg)
    std.task.finish_fiber(f)
}

fn fiber_entry_point_windows(param: *void) {
    f: *Fiber = cast(*Fiber, param)
    current_fiber = f
    f.func(f.arg)
    std.task.finish_fiber(f)
}

fn std.task.finish_fiber(f: *Fiber) {
    f.state = 2 
    active_fibers = active_fibers - 1 // Decrement when finished

    if Builtin.IsWindows {
        if cast(i64, scheduler_sp) != 0 {
            SwitchToFiber(cast(*void, scheduler_sp))
        }
        return
    }

    std.task.yield_to_scheduler()
}

fn std.task.ensure_windows_scheduler_fiber() -> bool {
    if !Builtin.IsWindows {
        return true
    }

    if cast(i64, scheduler_sp) != 0 {
        return true
    }

    scheduler_fiber: *void = ConvertThreadToFiber(cast(*void, 0))
    if cast(i64, scheduler_fiber) == 0 {
        return false
    }

    scheduler_sp = cast(*u8, scheduler_fiber)
    return true
}

export [noinline]
fn std.task.yield_to_scheduler() {
    if Builtin.IsWindows {
        if cast(i64, scheduler_sp) == 0 {
            return
        }
        SwitchToFiber(cast(*void, scheduler_sp))
        return
    }

    std.task.context_switch_barrier()
    std.task.swap_context(&(current_fiber.stack_ptr), scheduler_sp)
}

export [noinline]
fn std.task.resume(f: *Fiber) {
    current_fiber = f

    if Builtin.IsWindows {
        if !std.task.ensure_windows_scheduler_fiber() {
            return
        }
        SwitchToFiber(cast(*void, f.stack_ptr))
        return
    }

    std.task.context_switch_barrier()
    std.task.swap_context(&scheduler_sp, f.stack_ptr)
}

export [noinline, noclone]
fn std.task.swap_context(old_sp_ptr: **u8, new_sp: *u8) {
    if Builtin.IsX86_64 {
        if Builtin.IsWindows {
            asm {
                "subq $160, %%rsp\n\tmovdqu %%xmm6, 0(%%rsp)\n\tmovdqu %%xmm7, 16(%%rsp)\n\tmovdqu %%xmm8, 32(%%rsp)\n\tmovdqu %%xmm9, 48(%%rsp)\n\tmovdqu %%xmm10, 64(%%rsp)\n\tmovdqu %%xmm11, 80(%%rsp)\n\tmovdqu %%xmm12, 96(%%rsp)\n\tmovdqu %%xmm13, 112(%%rsp)\n\tmovdqu %%xmm14, 128(%%rsp)\n\tmovdqu %%xmm15, 144(%%rsp)\n\tpushq %%rbp; pushq %%rbx; pushq %%rdi; pushq %%rsi; pushq %%r12; pushq %%r13; pushq %%r14; pushq %%r15\n\tmovq %%rsp, (%0)\n\tmovq %1, %%rsp\n\tpopq %%r15; popq %%r14; popq %%r13; popq %%r12; popq %%rsi; popq %%rdi; popq %%rbx; popq %%rbp\n\tmovdqu 0(%%rsp), %%xmm6\n\tmovdqu 16(%%rsp), %%xmm7\n\tmovdqu 32(%%rsp), %%xmm8\n\tmovdqu 48(%%rsp), %%xmm9\n\tmovdqu 64(%%rsp), %%xmm10\n\tmovdqu 80(%%rsp), %%xmm11\n\tmovdqu 96(%%rsp), %%xmm12\n\tmovdqu 112(%%rsp), %%xmm13\n\tmovdqu 128(%%rsp), %%xmm14\n\tmovdqu 144(%%rsp), %%xmm15\n\taddq $160, %%rsp"
                : : "r"(old_sp_ptr), "r"(new_sp) : "memory"
            }
            return
        }

        asm {
            "pushq %%rbp; pushq %%rbx; pushq %%rdi; pushq %%rsi; pushq %%r12; pushq %%r13; pushq %%r14; pushq %%r15\n\tmovq %%rsp, (%0)\n\tmovq %1, %%rsp\n\tpopq %%r15; popq %%r14; popq %%r13; popq %%r12; popq %%rsi; popq %%rdi; popq %%rbx; popq %%rbp"
            : : "r"(old_sp_ptr), "r"(new_sp) : "memory"
        }
        return
    }

    if Builtin.IsAArch64 {
        aarch64_old_sp_ptr = old_sp_ptr
        aarch64_new_sp = new_sp
        std.task.swap_context_aarch64()
    }
}

// Keep the actual AArch64 stack switch parameterless. This prevents O0 from
// creating a hidden stack frame for argument spills around the inline asm.
export [noinline, noclone]
fn std.task.swap_context_aarch64() {
    if Builtin.IsAArch64 {
        asm {
            "stp x19, x20, [sp, #-16]!\n\tstp x21, x22, [sp, #-16]!\n\tstp x23, x24, [sp, #-16]!\n\tstp x25, x26, [sp, #-16]!\n\tstp x27, x28, [sp, #-16]!\n\tstp x29, x30, [sp, #-16]!\n\tstp d8, d9, [sp, #-16]!\n\tstp d10, d11, [sp, #-16]!\n\tstp d12, d13, [sp, #-16]!\n\tstp d14, d15, [sp, #-16]!\n\tmov x2, sp\n\tstr x2, [%0]\n\tmov sp, %1\n\tldp d14, d15, [sp], #16\n\tldp d12, d13, [sp], #16\n\tldp d10, d11, [sp], #16\n\tldp d8, d9, [sp], #16\n\tldp x29, x30, [sp], #16\n\tldp x27, x28, [sp], #16\n\tldp x25, x26, [sp], #16\n\tldp x23, x24, [sp], #16\n\tldp x21, x22, [sp], #16\n\tldp x19, x20, [sp], #16"
            : : "r"(aarch64_old_sp_ptr), "r"(aarch64_new_sp) : "x2", "memory"
        }
    }
}

export fn std.task.spawn(gpa: *std.mem.HeapAllocator, taskFunc: fn(*void) -> void, arg: *void) !i32 {
    if cast(i64, gpa) == 0 {
        return error.InvalidArgument
    }

    if !std.task.is_supported() {
        return error.UnsupportedPlatform
    }

    if Builtin.IsX86_64 {
        if Builtin.IsWindows {
            if !std.task.ensure_windows_scheduler_fiber() {
                return error.IOError
            }

            fiber_mem: *u8 = std.os.get_pages(4096) catch |fiber_err| {
                return error.OutOfMemory
            }
            f: *Fiber = cast(*Fiber, fiber_mem)

            f.id = task_next_id
            task_next_id = task_next_id + 1
            f.stack_ptr = cast(*u8, 0)
            f.owned_stack_ptr = cast(*u8, 0)
            f.owned_stack_len = 0
            f.owned_record_ptr = fiber_mem
            f.owned_record_len = 4096
            f.func = taskFunc
            f.arg = arg
            f.state = 0
            f.next = cast(*Fiber, 0)
            f.wait_fd = -1
            f.wait_events = cast(i16, 0)
            f.wait_revents = cast(i16, 0)
            f.wait_deadline_ms = -1
            f.wait_timed_out = false
            f.waiting_next = cast(*Fiber, 0)

            stack_size: i64 = 65536
            fiber_handle: *void = CreateFiber(stack_size, fiber_entry_point_windows, cast(*void, f))
            if cast(i64, fiber_handle) == 0 {
                std.os.free_pages(fiber_mem, 4096) catch |free_err| {
                    return error.OutOfMemory
                }
                return error.OutOfMemory
            }

            f.stack_ptr = cast(*u8, fiber_handle)
            active_fibers = active_fibers + 1
            std.task.enqueue(f)
            return 0
        }

        stack_size: i64 = 65536
        raw_stack: *u8 = std.os.get_pages(stack_size) catch |stack_err| {
            return error.OutOfMemory
        }
        fiber_mem: *u8 = std.os.get_pages(4096) catch |fiber_err| {
            std.os.free_pages(raw_stack, stack_size) catch |free_err| {
                return error.OutOfMemory
            }
            return error.OutOfMemory
        }
        f: *Fiber = cast(*Fiber, fiber_mem)
        
        f.id = task_next_id
        task_next_id = task_next_id + 1
        f.stack_ptr = cast(*u8, 0)
        f.owned_stack_ptr = raw_stack
        f.owned_stack_len = stack_size
        f.owned_record_ptr = fiber_mem
        f.owned_record_len = 4096
        f.func = taskFunc
        f.arg = arg
        f.state = 0
        f.next = cast(*Fiber, 0)
        f.wait_fd = -1
        f.wait_events = cast(i16, 0)
        f.wait_revents = cast(i16, 0)
        f.wait_deadline_ms = -1
        f.wait_timed_out = false
        f.waiting_next = cast(*Fiber, 0)
        active_fibers = active_fibers + 1 // Increment when created
        
        top: i64 = (cast(i64, raw_stack) + stack_size) & -16
        if Builtin.IsWindows {
            // Reserve the initial Win64 shadow space plus the entry return slot.
            // After swap_context restores and returns into fiber_entry_point,
            // rsp must be 8 mod 16 and still leave 32 bytes of home space.
            top = top - 40
        }
        sp_exec: **u8 = cast(**u8, top - 8)
        sp_exec[0] = cast(*u8, fiber_entry_point)
        if Builtin.IsWindows {
            f.stack_ptr = cast(*u8, top - 232)
        } else {
            f.stack_ptr = cast(*u8, top - 72)
        }
        
        std.task.enqueue(f)
        return 0
    } else if Builtin.IsAArch64 {
        stack_size: i64 = 65536
        raw_stack: *u8 = std.os.get_pages(stack_size) catch |stack_err| {
            return error.OutOfMemory
        }
        fiber_mem: *u8 = std.os.get_pages(4096) catch |fiber_err| {
            std.os.free_pages(raw_stack, stack_size) catch |free_err| {
                return error.OutOfMemory
            }
            return error.OutOfMemory
        }
        f: *Fiber = cast(*Fiber, fiber_mem)

        f.id = task_next_id
        task_next_id = task_next_id + 1
        f.stack_ptr = cast(*u8, 0)
        f.owned_stack_ptr = raw_stack
        f.owned_stack_len = stack_size
        f.owned_record_ptr = fiber_mem
        f.owned_record_len = 4096
        f.func = taskFunc
        f.arg = arg
        f.state = 0
        f.next = cast(*Fiber, 0)
        f.wait_fd = -1
        f.wait_events = cast(i16, 0)
        f.wait_revents = cast(i16, 0)
        f.wait_deadline_ms = -1
        f.wait_timed_out = false
        f.waiting_next = cast(*Fiber, 0)
        active_fibers = active_fibers + 1

        top: i64 = (cast(i64, raw_stack) + stack_size) & -16
        // AAPCS64 requires x19-x30 and the low 64 bits of v8-v15 to survive
        // a call. The initial frame mirrors swap_context's restore order.
        ctx: **u8 = cast(**u8, top - 160)
        ctx[0] = cast(*u8, 0)
        ctx[1] = cast(*u8, 0)
        ctx[2] = cast(*u8, 0)
        ctx[3] = cast(*u8, 0)
        ctx[4] = cast(*u8, 0)
        ctx[5] = cast(*u8, 0)
        ctx[6] = cast(*u8, 0)
        ctx[7] = cast(*u8, 0)
        ctx[8] = cast(*u8, 0)
        ctx[9] = cast(*u8, cast(i64, fiber_entry_point))
        ctx[10] = cast(*u8, 0)
        ctx[11] = cast(*u8, 0)
        ctx[12] = cast(*u8, 0)
        ctx[13] = cast(*u8, 0)
        ctx[14] = cast(*u8, 0)
        ctx[15] = cast(*u8, 0)
        ctx[16] = cast(*u8, 0)
        ctx[17] = cast(*u8, 0)
        ctx[18] = cast(*u8, 0)
        ctx[19] = cast(*u8, 0)
        f.stack_ptr = cast(*u8, ctx)

        std.task.enqueue(f)
        return 0
    } else {
        return error.UnsupportedPlatform
    }
}

export fn std.task.yield() {
    if !std.task.is_supported() {
        return
    }

    if cast(i64, current_fiber) == 0 {
        return
    }

    std.task.enqueue(current_fiber)
    std.task.yield_to_scheduler()
}

export fn std.task.has_ready_fibers() -> bool {
    if cast(i64, ready_queue_head) == 0 {
        return false
    }

    return true
}

export fn std.task.enqueue(f: *Fiber) {
    f.next = cast(*Fiber, 0)
    if cast(i64, ready_queue_tail) == 0 {
        ready_queue_head = f
        ready_queue_tail = f
    } else {
        ready_queue_tail.next = f
        ready_queue_tail = f
    }
}

export fn std.task.dequeue() -> *Fiber {
    if cast(i64, ready_queue_head) == 0 { return cast(*Fiber, 0) }
    f: *Fiber = ready_queue_head
    ready_queue_head = f.next
    if cast(i64, ready_queue_head) == 0 { ready_queue_tail = cast(*Fiber, 0) }
    return f
}

export fn std.task.dispose_dead_fiber(f: *Fiber) {
    if f.state != 2 {
        return
    }

    owned_stack_ptr: *u8 = f.owned_stack_ptr
    owned_stack_len: i64 = f.owned_stack_len
    owned_record_ptr: *u8 = f.owned_record_ptr
    owned_record_len: i64 = f.owned_record_len

    if !Builtin.IsWindows {
        if cast(i64, owned_stack_ptr) != 0 && owned_stack_len > 0 {
            std.os.free_pages(owned_stack_ptr, owned_stack_len) catch |free_err| {}
        }

        if cast(i64, owned_record_ptr) != 0 && owned_record_len > 0 {
            std.os.free_pages(owned_record_ptr, owned_record_len) catch |free_err| {}
        }
        return
    }

    if cast(i64, f.stack_ptr) != 0 {
        DeleteFiber(cast(*void, f.stack_ptr))
    }

    if cast(i64, owned_record_ptr) != 0 && owned_record_len > 0 {
        std.os.free_pages(owned_record_ptr, owned_record_len) catch |free_err| {}
    }
}
